exec SuppressInfoUpdateFW
exec DisableAutoUpdateFW
exec SuppressGUI
si SWD
speed 1000
device STM32F429ZI
connect
rsettype 0
r
h
w4 0x40023C00 0x00000705
w4 0x40023800 0x00010001
sleep 10
w4 0x40023804 0x07405408
w4 0x40023800 0x01010001
sleep 10
w4 0x40023808 0x00009402
sleep 5
w4 0xE000EDFC 0x01000000
w4 0x40023830 0x00100002
w4 0x40020400 0x00000280
w4 0x40020408 0x000000C0
w4 0x40020420 0x00000000
w4 0xE0042004 0x00000027
w4 0xE0040FB0 0xC5ACCE55
// 168MHz/2MHz ACPR=83=0x53
w4 0xE0040010 0x00000053
w4 0xE00400F0 0x00000002
w4 0xE0040304 0x00000102
w4 0xE0001FB0 0xC5ACCE55
w4 0xE0001000 0x40000C01
w4 0xE0000FB0 0xC5ACCE55
w4 0xE0000E80 0x0001000D
w4 0xE0041FB0 0xC5ACCE55
// br_out=0 stall=1 -> config 0xC80, run 0x880
w4 0xE0041000 0x00000C80
w4 0xE0041000 0x00000880
mem32 0xE0041000 1
go
sleep 99999999
exit
