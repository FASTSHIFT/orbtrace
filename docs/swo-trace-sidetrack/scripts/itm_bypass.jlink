exec SuppressInfoUpdateFW
exec DisableAutoUpdateFW
exec SuppressGUI
si SWD
speed 1000
device STM32F429ZI
connect
r
go
sleep 500
halt
mem32 0x40023808 1
w4 0xE000EDFC 0x01000000
w4 0x40023830 0x00100002
w4 0x40020400 0x00000280
w4 0x40020408 0x000000C0
w4 0x40020420 0x00000000
w4 0xE0042004 0x00000027
// TPIU NRZ, formatter BYPASS (0x100) - pure ITM UART out, 168/2MHz
w4 0xE0040FB0 0xC5ACCE55
w4 0xE0040010 0x00000053
w4 0xE00400F0 0x00000002
w4 0xE0040304 0x00000100
// ITM ENA|SYNCENA busID1, NO timestamp first (cleanest), port0
w4 0xE0000FB0 0xC5ACCE55
w4 0xE0000E80 0x00010005
w4 0xE0000E00 0xFFFFFFFF
w4 0xE0000E40 0x0000000F
mem32 0xE0000E80 1
go
sleep 99999999
exit
