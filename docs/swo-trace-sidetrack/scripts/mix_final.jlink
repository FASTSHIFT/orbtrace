exec SuppressInfoUpdateFW
exec DisableAutoUpdateFW
exec SuppressGUI
si SWD
speed 1000
device STM32F429ZI
connect
r
go
sleep 500
halt
// Downscale to HSI 16MHz to give ITM bandwidth headroom
w4 0x40023808 0x00009408
sleep 5
mem32 0x40023808 1
w4 0xE000EDFC 0x01000000
w4 0x40023830 0x00100002
w4 0x40020400 0x00000280
w4 0x40020408 0x000000C0
w4 0x40020420 0x00000000
w4 0xE0042004 0x00000027
// TPIU NRZ FORMATTER ON 16MHz/2MHz ACPR=7
w4 0xE0040FB0 0xC5ACCE55
w4 0xE0040010 0x00000007
w4 0xE00400F0 0x00000002
w4 0xE0040304 0x00000102
w4 0xE0001FB0 0xC5ACCE55
w4 0xE0001000 0x00000001
// ITM: ENA only + busID1, NO SYNCENA, NO TSENA (avoid sync/ts flood)
// bit0 ENA=1, busID[22:16]=1 -> 0x00010001
w4 0xE0000FB0 0xC5ACCE55
w4 0xE0000E80 0x00010001
w4 0xE0000E00 0xFFFFFFFF
w4 0xE0000E40 0x0000000F
// ETMv3.5 br_out=0 stall=1
w4 0xE0041FB0 0xC5ACCE55
w4 0xE0041000 0x00000400
w4 0xE0041200 0x00000002
w4 0xE0041008 0x0000406F
w4 0xE0041020 0x0000006F
w4 0xE0041024 0x20000001
w4 0xE004102C 0x00000008
w4 0xE004101C 0x00000000
w4 0xE0041000 0x00000C80
w4 0xE0041000 0x00000880
mem32 0xE0041000 1
go
sleep 99999999
exit
